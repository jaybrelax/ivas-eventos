# Endereço da API do Appwrite (o mesmo que aparece em Settings do projeto no console)
# Rodando o Appwrite local no Docker, normalmente: http://localhost/v1
APPWRITE_ENDPOINT=http://localhost/v1
APPWRITE_PROJECT_ID=rituais-ivas
# Chave de API do projeto (Overview > Integrations > API keys) com TODOS os escopos
APPWRITE_API_KEY=cole-a-chave-aqui

# Primeiro usuário Admin, criado pelo `npm run setup`
ADMIN_EMAIL=jay@brelaz.tv
ADMIN_PASSWORD=troque-esta-senha
ADMIN_NAME=Jay
