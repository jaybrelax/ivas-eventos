# Projeto Appwrite compartilhado com o sistema que cadastra os rituais
APPWRITE_ENDPOINT=https://seu-appwrite.example/v1
APPWRITE_PROJECT_ID=seu-projeto-appwrite
APPWRITE_API_KEY=cole-a-chave-de-api-aqui

# Domínio exclusivo da Guarnição
NEXT_PUBLIC_SITE_URL=https://guarnicao.virtudes.net.br

# OAuth: cadastre https://guarnicao.virtudes.net.br/api/auth/google/callback no Google
GOOGLE_CLIENT_ID=seu-client-id
GOOGLE_CLIENT_SECRET=seu-client-secret

# Notificações push dos guardiões
NEXT_PUBLIC_VAPID_PUBLIC_KEY=sua-chave-publica
VAPID_PRIVATE_KEY=sua-chave-privada
VAPID_SUBJECT=mailto:contato@virtudes.net.br

# Protege o endpoint diário de lembretes
CRON_SECRET=seu-segredo-aleatorio
